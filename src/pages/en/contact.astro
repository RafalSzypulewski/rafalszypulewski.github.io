---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const labels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  mail: "Email",
};
---

<Layout title={`${t.nav.contact} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.nav.contact}
    pageDesc="The best ways to reach me."
    class="app-prose"
  >
    <ul>
      {
        config.socials.map(({ name, url }) => (
          <li>
            <a href={url}>{labels[name] ?? name}</a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>

---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title={`${t.nav.projects} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.nav.projects} pageDesc="Things I've built and tested.">
    <ul>
      {
        projects.map(({ id, data }) => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `projects/${id}`)}
              class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
            >
              <h2 class="text-lg font-medium">{data.title}</h2>
            </a>
            <p>{data.description}</p>
            <p class="mt-1 text-sm opacity-80">{data.tools.join(" · ")}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
